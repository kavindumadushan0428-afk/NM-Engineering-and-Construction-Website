# Public HTTPS origin, without a trailing path. Required before public launch.
# Leave empty for local previews (search indexing remains disabled).
NEXT_PUBLIC_SITE_URL=

# Optional server-only email delivery. Without these, forms prepare an email draft.
# Verify your sender domain in Resend before enabling.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
# Defaults to the company's existing public email when left empty.
INQUIRY_TO_EMAIL=
